# Configurações de ambiente para Ferramentas de Rede
# Copie este arquivo para .env e configure conforme necessário

# Configurações de log
LOG_LEVEL=INFO
LOG_FILE_PATH=data/logs/app.log

# Configurações de rede
DEFAULT_PING_TIMEOUT=1000
DEFAULT_SCAN_TIMEOUT=5000
MAX_CONCURRENT_CONNECTIONS=20

# Configurações de segurança
ENABLE_CREDENTIAL_ENCRYPTION=true
CREDENTIAL_SALT_FILE=csalt.key
CREDENTIAL_DATA_FILE=credentials.json.enc

# Configurações de performance
CACHE_TIMEOUT_SECONDS=30
MAX_CACHE_SIZE=1000
ENABLE_PERFORMANCE_MONITORING=true

# Configurações de interface
DEFAULT_THEME=dark
DEFAULT_LANGUAGE=pt-BR
AUTO_SAVE_PREFERENCES=true